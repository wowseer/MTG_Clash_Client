+    /** Textfeld (z. B. ein Pfad); uebernommen bei Enter und beim Verlassen des Feldes. */
+    private static HBox textRow(final String caption, final String value, final Consumer<String> onChange) {
+        final javafx.scene.control.TextField field = new javafx.scene.control.TextField(value);
+        field.setPrefColumnCount(28);
+        field.setOnAction(e -> onChange.accept(field.getText().trim()));
+        field.focusedProperty().addListener((obs, was, now) -> {
+            if (!now) {
+                onChange.accept(field.getText().trim());
+            }
+        });
+        return row(caption, field);
+    }
+
     private static double clamp(final double v, final double lo, final double hi) {
